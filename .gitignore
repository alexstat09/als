# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
als/

# Render-harness artifacts. A headless render of a page is written here as a
# throwaway copy; it must never be committed or deployed.
_*.html
render-*.html

# Garmin probe output. Holds a live Garmin session token and a raw night of
# Chrissie's sleep. Never commit either — the token is a credential and the
# night is her health data.
tests/garmin-probe-out/

# Quarantine — holding pen for the above once they've served their purpose.
# Never committed, never deployed. Safe to delete the whole folder at any time.
_quarantine/

# Environment files. `vercel env pull` writes decrypted secrets here —
# MCP_TOKEN, GEMINI_API_KEY, the Garmin OAuth1 pair, the Supabase service key.
# Every one of them is a live credential. Never commit any of these.
.env
.env.*
!.env.example
